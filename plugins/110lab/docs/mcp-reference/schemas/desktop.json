[
  {
    "name": "weknow_latex_status",
    "description": "查看本地编辑器、编译组件和联网同步状态。不会开始上传。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "weknow_latex_projects_list",
    "description": "列出当前设备上已缓存的项目，返回稳定 projectId、待同步状态和离线准备状态。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "weknow_latex_files_list",
    "description": "列出指定本地项目的文本及资源文件元数据，不返回正文。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "projectId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "weknow_latex_file_read",
    "description": "分页读取本地文本，返回整份文件的 localRevision。limit 为字符数；偏移也按字符计算。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64000,
          "default": 16000
        }
      },
      "required": [
        "projectId",
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "weknow_latex_file_write",
    "description": "按 localRevision 更新本机文本并立即落盘；不会直接覆盖云端。并发冲突返回错误。未知结果重试需保持同一 requestId 和相同正文。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "maxLength": 524288
        },
        "expectedLocalRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "projectId",
        "path",
        "content",
        "expectedLocalRevision",
        "requestId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "weknow_latex_file_create",
    "description": "在已缓存项目中新建文本文件，联网时按同一 requestId 创建到云端；同名云端文件会阻止覆盖。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "maxLength": 524288
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "projectId",
        "path",
        "content",
        "requestId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "weknow_latex_compile",
    "description": "用已准备的原生 TeX 组件在本机离线生成 PDF；返回版本、摘要和日志，不把 PDF 正文放入上下文。失败不冒充旧 PDF 为本次成功。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "projectId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "weknow_latex_sync",
    "description": "尝试同步此项目，重新验证云端身份与权限；返回真实状态。遇到冲突保留本地和云端内容；断网不丢弃草稿。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "projectId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "weknow_latex_conflict_resolve",
    "description": "显式保存合并后的文本，继续进入同步队列；应先读取冲突双方，不能猜测合并内容。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "maxLength": 524288
        }
      },
      "required": [
        "projectId",
        "path",
        "content"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  }
]
